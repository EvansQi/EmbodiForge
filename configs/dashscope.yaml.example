# EmbodiedForge pipeline — 阿里云 DashScope (Qwen-VL API) 配置
#
# 使用方式:
#   1. 复制此文件: cp configs/dashscope.yaml.example configs/dashscope.yaml
#   2. 填写你的 API Key 或设置环境变量 DASHSCOPE_API_KEY
#   3. 运行: eforge run-all --episode-dir examples/sample_episode --config configs/dashscope.yaml

ingest:
  fps: 30.0

segment:
  skills:
    - reach
    - grasp
    - lift
    - place
  force_threshold: 5.0
  velocity_threshold: 0.01
  gripper_close_threshold: 0.5
  min_stage_frames: 5

# ===== Qwen-VL via DashScope API =====
semantic:
  backend: qwen_vl_remote
  kwargs:
    provider: dashscope
    model: qwen3-vl-plus          # 推荐: qwen3-vl-plus (最新), qwen-vl-max (Qwen2.5-72B)
    api_key: ""                   # 填你的 API Key，或设置 DASHSCOPE_API_KEY 环境变量
    max_tokens: 512
    temperature: 0.1
    timeout: 60

grounding:
  backend: mock
  confidence_threshold: 0.3
  kwargs: {}

segmentation:
  backend: mock
  kwargs: {}

affordance:
  sigma_factor: 0.15

depth:
  backend: mock
  base_depth: 0.5
  kwargs: {}

qc:
  min_mask_area: 100
  max_mask_ratio: 0.8
  min_bbox_ratio: 0.01
  max_bbox_ratio: 0.9
